# Copie ce fichier en `.env` puis remplis tes clés. Ne publie jamais ton `.env`.

# --- Cerveau (LLM) ---------------------------------------------------------
# N'importe quel service compatible avec l'API OpenAI fonctionne.
# Pour changer de LLM, il suffit de changer ces lignes.

# Groq (gratuit, très rapide) : clé sur https://console.groq.com/keys
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=gsk_...
LLM_MODEL=openai/gpt-oss-120b
# Pour les modèles qui "réfléchissent" (gpt-oss), "low" garde des réponses rapides.
# Laisse vide pour les autres modèles.
LLM_REASONING_EFFORT=low

# Autres exemples (décommente pour essayer) :
# Groq + Llama :   LLM_MODEL=llama-3.3-70b-versatile   (et LLM_REASONING_EFFORT vide)
# Mistral :        LLM_BASE_URL=https://api.mistral.ai/v1      LLM_MODEL=mistral-small-latest
# Ollama local :   LLM_BASE_URL=http://localhost:11434/v1      LLM_API_KEY=ollama   LLM_MODEL=qwen3:8b

# --- Recherche web ----------------------------------------------------------
# Tavily (1000 crédits gratuits / mois) : clé sur https://app.tavily.com
TAVILY_API_KEY=tvly-...

# --- Voix (serveurs Kyutai, voir serveurs-vocaux/) -------------------------
STT_URL=ws://127.0.0.1:8090
TTS_URL=ws://127.0.0.1:8089
KYUTAI_API_KEY=public_token
# Voix française de Kyutai (dans le dépôt Hugging Face kyutai/tts-voices).
# Autre voix française : unmute-prod-website/fabieng-enhanced-v2.wav
TTS_VOICE=unmute-prod-website/developpeuse-3.wav
